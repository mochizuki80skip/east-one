# East-one ホームページ（サブドメイン east-one.hachimaru-80skip.com の公開フォルダ直下に置く .htaccess）
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

RewriteEngine On

# 次のどれかで来たら https://east-one.hachimaru-80skip.com/ にそろえる（301 転送）
#  ・http でのアクセス
#  ・親ドメインのフォルダ経由（hachimaru-80skip.com/east-one/）や www 付きなど、別の名前でのアクセス
# 無料独自SSLが有効になる前にアップロードすると、https に転送されて表示できないので注意
RewriteCond %{HTTPS} !on [OR]
RewriteCond %{HTTP_HOST} !^east-one\.hachimaru-80skip\.com$ [NC]
RewriteRule ^(.*)$ https://east-one.hachimaru-80skip.com/$1 [R=301,L]

# /index.html を / にそろえる
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]

# 作業用のファイルを誤ってアップロードしても見られないようにする
<FilesMatch "\.(md|py|sh|zip|bak|log)$|^preview-.*\.html$">
  Require all denied
</FilesMatch>

# 文字・画像の圧縮（表示を速くする）
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType image/vnd.microsoft.icon "access plus 30 days"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
