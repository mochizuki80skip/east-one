# 設定・データ・ライブラリはブラウザから直接読めないようにする
Options -Indexes
<FilesMatch "^(config\.php|config\.sample\.php|composer\.(json|lock)|lib\.php|report\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
